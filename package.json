{
  "name": "walk-the-plan-crm-suite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "server": "node --watch backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently --kill-others \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install --prefix backend --legacy-peer-deps && npm install --prefix frontend --legacy-peer-deps"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

