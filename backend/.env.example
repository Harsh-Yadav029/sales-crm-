# CRM Backend Environment Variables Template
# On Render, configure these in Dashboard -> Environment instead of uploading a .env file.
CRM_PORT=
JWT_SECRET=
DB_PATH=
META_VERIFY_TOKEN=
# Optional: set DATA_DIR=/var/data on Render Persistent Disk to persist DB, uploads, and backups together
# DATA_DIR=/var/data
# Optional: require x-webhook-secret header on incoming webhook POST requests
# WEBHOOK_SECRET=your_webhook_secret_here
# Optional: Meta Page Access Token if receiving direct Meta Graph leadgen webhooks without Sheets/Zapier
# META_PAGE_ACCESS_TOKEN=your_meta_page_access_token

